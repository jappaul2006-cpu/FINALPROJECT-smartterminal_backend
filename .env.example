# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# OneSignal Web Push (announcements -> subscribed passengers)
# ONESIGNAL_REST_API_KEY is backend-only, never expose it to the frontend.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Browser origins allowed to call the API (comma separated).
# Local development: the Vite dev server.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Public URL of the frontend (used in push notification links).
APP_PUBLIC_URL=http://localhost:5173